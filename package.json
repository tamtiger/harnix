{
  "name": "@tamtiger/harnix",
  "version": "2.1.0",
  "description": "Coding-agent harness with project-local workflow data and user-global Kiro, Antigravity, Codex, Claude Code, OpenCode, and Cursor integrations.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "private": false,
  "bin": {
    "harnix": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "lint": "pnpm format:check && eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\" eslint.config.mjs tsup.config.ts vitest.config.ts",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\" eslint.config.mjs tsup.config.ts vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:migration": "vitest run test/migration",
    "test:platform": "vitest run test/platform",
    "test:workflow": "vitest run test/workflow",
    "test:safety": "vitest run test/safety",
    "test:acceptance": "pnpm run test",
    "pack:check": "node scripts/pack-check.mjs",
    "smoke:tarball": "node scripts/smoke-tarball.mjs",
    "measure:init": "node scripts/measure-init.mjs",
    "measure:footprint": "node scripts/measure-footprint.mjs",
    "measure:tokens": "node scripts/measure-tokens.mjs",
    "scan:release": "node scripts/scan-release.mjs",
    "version:sync": "node scripts/version-sync.mjs"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "globby": "^14.1.0",
    "inquirer": "^12.4.1",
    "minisearch": "^7.2.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.5",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  },
  "packageManager": "pnpm@11.4.0"
}
