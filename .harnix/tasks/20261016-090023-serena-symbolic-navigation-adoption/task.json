  "decisions": [
    {
      "id": "dec-serena-clean-room",
      "text": "Thích nghi clean-room điều hướng symbol (repo-map --outline) và tra cứu tham chiếu (repo-map --refs) từ oraios/serena mà không chạy LSP daemon, không thêm MCP server và không đổi schema cache RepoMapV1",
      "rationale": "Serena dùng GPL-3.0-or-later và kiến trúc Python LSP/MCP server; Harnix giữ ranh giới một gói npm độc lập, deterministic, zero-daemon và tương thích ngược hoàn toàn với RepoMapV1"
    },
    {
      "id": "dec-brief-actions-golden",
      "text": "Khi thêm action ghi mới vào harnix workflow, luôn thêm action vào BRIEF_ACTIONS trong src/core/workflow/brief.ts đồng thời cập nhật constraints.brief trong test/workflow/behavior-snapshot.golden.json.",
      "rationale": "Giữ nhất quán giữa assertCommandShape, workflow.md cookbook, Rule 10 và snapshot schema"
    }
  ],
  "residualRisks": [
    {
      "id": "risk-lexical-span-limits",
      "text": "Trích xuất giới hạn dòng symbol (startLine-endLine) và tham chiếu bằng bộ phân tích lexical/ngoặc/thụt lề không giải quyết dynamic dispatch hoặc macro phức tạp như LSP đầy đủ",
