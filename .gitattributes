# Standardize line endings across all platforms
* text=auto eol=lf

# Source and documentation
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Windows command shims require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
